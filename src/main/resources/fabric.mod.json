{
  "schemaVersion": 1,
  "id": "cnb",
  "version": "${version}",
  "name": "Creatures and Beasts: Unofficial Port",
  "description": "Creatures and Beasts is a vanilla-style creature mod which fills each biome with new mobs, from the plains of the overworld to the void of the end!",
  "authors": [
    "Joosh",
    "CGessinger",
    "HellionGames"
  ],
  "contact": {
    "sources": "https://github.com/CreaturesAndBeasts/Creatures_And_Beasts-Forge",
    "issues": "https://github.com/nice-john/Creatures_And_Beasts-Forge/issues"
  },
  "license": "LGPLv3",
  "icon": "logo.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.cgessinger.creaturesandbeasts.CreaturesAndBeasts"
    ],
    "client": [
      "com.cgessinger.creaturesandbeasts.CreaturesAndBeastsClient"
    ]
  },
  "mixins": [
    "creatures-and-beasts.mixins.json"
  ],
  "accessWidener": "creatures-and-beasts.aw",
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*",
    "geckolib": "*"
  }
}
